  "devDependencies": {
    "better-docs": "^2.7.2",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@babel/preset-env": "^7.23.5",
    "ts-jest": "^29.1.1",
    "glob": "^10.3.10"
